{
  "page_metadata": {
    "title": "Adapting existing toxicokinetic models to relate perfluoroalkyl and polyfluoroalkyl intake to biomarkers in humans",
    "authors": [
      "Kara J. Dean",
      "Régis Pouillot",
      "Jane M. Van Doren",
      "Sofia M. Santillana Farakos"
    ],
    "journal": "Toxicological Sciences",
    "year": 2025
  },
  "model_classification": {
    "model_type": "simple_empirical_compartmental",
    "evidence_quote": "Fig. 1. Schematic for the three-compartment model (Vc, Vt, Vfil) with a saturable resorption process (Tm, Kt)."
  },
  "model_context": {
    "model_origin": "adapted from Wambaugh et al. (2013) nonhuman-primate three-compartment model and scaled to humans",
    "stated_purpose": "Relate PFAS intake/exposure to human serum biomarkers and support forward/reverse dosimetry and risk assessment for PFOS, PFOA, and PFHxS",
    "dose_metric": "serum concentration and risk-assessment exposure metric (PODHED)"
  },
  "biological_basis": {
    "adme_determinants": [
      "cardiac output",
      "filtrate compartment volume",
      "central and second compartment volumes",
      "saturable renal resorption",
      "serum protein binding/free fraction",
      "oral absorption"
    ],
    "stated_assumptions": [
      {
        "description": "Human scaling uses body weight 70 kg and cardiac output 12.5 L/h/kg^0.74.",
        "evidence_quote": "We scaled the reparametrized Wambaugh model ... to humans using human values for the bodyweight (70 kg) and cardiac output (12.5 L/h/kg0.74)",
        "source_location": "Methods, p.2"
      },
      {
        "description": "For human models, the Tmc value was fit to representative human half-lives.",
        "evidence_quote": "adjusted the maximum rate of the saturable resorption parameter (Tm, mg/h) to match the half-life estimated in humans",
        "source_location": "Methods, p.2"
      },
      {
        "description": "Human bioavailability was set to 90% for PFOS and PFOA.",
        "evidence_quote": "assuming a bioavailability of 90% for application in the human model",
        "source_location": "Results, p.4"
      },
      {
        "description": "PFHxS bioavailability and saturable resorption affinity were assumed equal to PFOS.",
        "evidence_quote": "Assumed (PFOS)",
        "source_location": "Table 3, p.7"
      }
    ],
    "specialized_mechanisms": [
      "saturable renal resorption"
    ]
  },
  "model_structure": {
    "reported_compartment_count": 3,
    "listed_compartment_count": 3,
    "count_consistency": "consistent",
    "compartments": [

# ==============================================================================
# APEX v2 Model & Server Environment Configuration (.env.example)
# ==============================================================================

# --- Priority 1: Local SGLang Server (Default Port: 30000) ---
# If a local SGLang instance is running on this machine, APEX v2 will use it first.
SGLANG_LOCAL_URL=http://127.0.0.1:30000

# --- Priority 2: Direct DGX SGLang Server (Port: 30001 via Tailscale/VPN) ---
# If the local server is unavailable, APEX v2 connects directly to your DGX server.
DGX_SGLANG_URL=http://100.85.128.70:30001

# --- Priority 3: OpenAI-Compatible API / Cloud Endpoints ---
# Used when connecting to DGX or external API providers (e.g. vLLM, SGLang, OpenAI, DeepSeek)
OPENAI_BASE_URL=http://100.85.128.70:30001/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=Qwen/Qwen3.8-27B-FP8

# --- Optional: Force a specific backend ---
# Values: "auto" (default: local -> dgx -> api -> engine), "local", "dgx", "api", "engine"
FORCE_BACKEND=auto

# --- General Pipeline Settings ---
LOG_LEVEL=INFO
OUTPUT_DIR=output
USE_MOCKS=False


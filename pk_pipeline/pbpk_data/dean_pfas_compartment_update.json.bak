        "confidence": 0.9
      }
    ],
    "absorption": {
      "route": "oral",
      "model_type": "first_order",
      "site": "central compartment input",
      "evidence_quote": "The figure labels the oral input with ka; the model description identifies ka as the rate from gut to central compartment."
    },
    "metabolism": null,
    "elimination": {
      "routes": [
        "renal filtration",
        "saturable renal resorption"
      ],
      "evidence_quote": "The model contains a filtrate compartment and a saturable resorption process parameterized by Tm and Kt."
    },
    "unresolved": [
      {
        "description": "Human models inherit several parameters unchanged from the nonhuman-primate model and those values are not repeated in the human columns.",
        "reason": "The text states that the remaining parameters were held constant, so the inherited values are represented explicitly rather than copied as new human fits."
      }
    ],
    "source_location": "Figure 1, page 3",
    "equations_provided": "text",
    "allometric_scaling_rules": [
      "Vt = k12/k21 * Vc",
      "Vfil = VfilC * BW",
      "Qfil = QfilC * QCC * BW^0.74",
      "Human BW = 70 kg; QCC = 12.5 L/h/kg^0.74"
    ]
  },
